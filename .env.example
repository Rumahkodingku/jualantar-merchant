# Relative path so the Vite dev server proxies API calls (avoids CORS in development).
# Use an absolute URL in production, e.g. https://api.example.com/api/v1
VITE_API_URL=/api/v1
VITE_APP_VERSION=
VITE_SUPPORT_PHONE=
VITE_SUPPORT_EMAIL=
VITE_PRIVACY_URL=
VITE_TERMS_URL=

# Backend target used by the Vite dev proxy.
# - Local `php artisan serve`: http://127.0.0.1:8000
# - Docker Compose api service: http://127.0.0.1:8100
API_PROXY_TARGET=http://127.0.0.1:8000
