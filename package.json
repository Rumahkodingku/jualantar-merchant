{
    "name": "jualantar-merchant",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "react-router build && bun run build:sw",
        "build:sw": "esbuild app/pwa/sw.ts --bundle --format=iife --target=es2020 --outfile=build/client/sw.js",
        "dev": "react-router dev --port 5174",
        "start": "react-router-serve ./build/server/index.js",
        "typecheck": "react-router typegen && tsc && tsc -p tsconfig.sw.json",
        "lint": "eslint .",
        "check": "bun run typecheck && bun run lint && bun run test:run",
        "test": "vitest",
        "test:run": "vitest run",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "format": "prettier --write \"**/*.{ts,tsx}\""
    },
    "dependencies": {
        "@base-ui/react": "^1.8.0",
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
        "@hookform/resolvers": "^5.9.1",
        "@react-router/node": "7.15.1",
        "@react-router/serve": "7.15.1",
        "@shadcn/react": "^0.3.1",
        "@tanstack/react-query": "^5.102.8",
        "axios": "^1.20.0",
        "class-variance-authority": "^0.7.1",
        "cmdk": "^1.1.1",
        "cn": "^0.2.5",
        "date-fns": "^4.4.0",
        "embla-carousel-react": "^8.6.0",
        "input-otp": "^1.5.0",
        "isbot": "^5",
        "lucide-react": "^1.41.0",
        "react": "^19.2.6",
        "react-day-picker": "^10.0.1",
        "react-dom": "^19.2.6",
        "react-hook-form": "^7.87.0",
        "react-resizable-panels": "^4.12.4",
        "react-router": "7.15.1",
        "recharts": "3.8.0",
        "shadcn": "^4.21.0",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.6.2",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "@react-router/dev": "7.15.1",
        "@tailwindcss/vite": "^4",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/node": "^22",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@vitejs/plugin-react": "^6.1.1",
        "agent-browser": "^0.38.1",
        "esbuild": "^0.28.2",
        "eslint": "^10.11.0",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-boundaries": "^7.2.0",
        "jsdom": "^30.0.1",
        "prettier": "^3.8.3",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "tailwindcss": "^4",
        "typescript": "^6",
        "typescript-eslint": "^8.70.1",
        "vite": "^8",
        "vitest": "^5.0.0"
    }
}
